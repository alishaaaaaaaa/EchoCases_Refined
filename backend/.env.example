# Copy to backend/.env and fill in. Never commit the real .env.

# Gemini API key for the AI case analysis
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini model name
# GEMINI_MODEL=gemini-1.5-flash

# Signs login tokens. Required, at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ECHOCASES_SECRET_KEY=

# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Largest dataset upload accepted, in MB
MAX_UPLOAD_MB=10

# Set to 1 only for local development; never on a shared network
FLASK_DEBUG=0
